{
	"name": "web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:node": "DEPLOY_PLATFORM=node pnpm run build",
		"deploy": "DEPLOY_PLATFORM=cloudflare pnpm run build && wrangler deploy",
		"preview": "vite preview",
		"lint": "oxlint",
		"lint:write": "oxlint --fix",
		"auth:generate": "pnpx --yes @better-auth/cli@latest generate --config src/server/auth.ts --output src/server/db/auth.schema.ts -y",
		"db:up": "turso dev --port=5555 --db-file=local.db",
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "drizzle-kit migrate",
		"db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
		"db:studio:dev": "drizzle-kit studio",
		"db:studio:prod": "NODE_ENV=production drizzle-kit studio",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/client": "0.0.2-alpha.3",
		"@better-auth/stripe": "^1.7.18",
		"@libsql/client": "^0.18.0",
