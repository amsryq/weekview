{
	"name": "@weekview/uitm-scraper",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test:fetch": "tsx tests/fetch.ts"
	},
	"dependencies": {
		"node-html-parser": "^7.1.0",
		"tough-cookie": "^6.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"@types/tough-cookie": "^4.0.5",
		"tsdown": "^0.21.4",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2"
	}
}
